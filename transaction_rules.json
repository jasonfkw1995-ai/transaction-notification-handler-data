      "merchantGroupIndex": 3,
      "amountGroupIndex": 4,
      "methodGroupIndex": 1,
      "methodTemplate": "* {cardLast4}",
      "dateGroupIndex": 2,
      "currency": "HKD",
      "dateFrom": "text",
