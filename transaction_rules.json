      "titleRejectRegex": "^(正在準備收據|Google 錢包|另 [0-9]+ 則通知)$",
      "textRegex": "^\\s*([^0-9\\s(]+)\\s*([0-9][0-9,.]*)\\s*\\(使用 (.+) 付款\\)\\s*$",
